# Copia este archivo como .env y pide los valores reales por un canal privado (no por GitHub).

# Conexión directa a Postgres (Supabase) para SQLAlchemy/Alembic.
# Supabase → Project Settings → Database → Connection string → Session pooler
# (usa el "Session pooler", no la conexión directa, si tu red no tiene salida IPv6).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth (sign up / sign in / validar tokens) — misma cuenta, no la base de datos en sí.
# Supabase → Project Settings → API Keys → "Publishable and secret API keys"
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Origen permitido para CORS — debe coincidir con la URL donde corre el frontend.
FRONTEND_URL=http://localhost:3000
